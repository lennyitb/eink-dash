TZ=America/New_York

# --- Kindle display ---
KINDLE_HOST=10.0.0.168
PUSH_ENABLED=true
# 90 or 270: flip if the dashboard appears upside down
ROTATE=90
PUSH_INTERVAL_S=60
NIGHT_PUSH_INTERVAL_S=60
FULL_REFRESH_MIN=15
# Frontlight 0-24: fades from DAY to NIGHT level over DIM_RAMP_MIN starting at NIGHT_START,
# and back up over WAKE_RAMP_MIN starting at NIGHT_END.
DAY_BRIGHTNESS=20
NIGHT_BRIGHTNESS=1
NIGHT_START=22:00
NIGHT_END=07:00
DIM_RAMP_MIN=60
WAKE_RAMP_MIN=30
CLOCK_24H=false

# --- Content ---
# Google Calendar: Settings > (calendar) > Integrate calendar > "Secret address in iCal format".
# Space-separate several URLs.
CALENDAR_ICS_URLS=
AGENDA_DAYS=10
WEATHER_LAT=
WEATHER_LON=
WEATHER_UNITS=fahrenheit
# Birthdays from iCloud Contacts: Apple ID email + an app-specific password
# (account.apple.com > Sign-In and Security > App-Specific Passwords). Leave blank to skip.
ICLOUD_USERNAME=
ICLOUD_APP_PASSWORD=
BIRTHDAY_SHOW_AGE=true
BIRTHDAY_FIRST_NAMES=false

# --- Access ---
# REST API: send "Authorization: Bearer $API_TOKEN"  (openssl rand -hex 24)
API_TOKEN=
# claude.ai connector (MCP at $PUBLIC_BASE_URL/mcp) uses the same single-user OAuth
# as canvas-viewer-mcp: a password login page during connect.
PUBLIC_BASE_URL=https://eink.lenny.zone
AUTH_PASSWORD=
DB_PATH=/data/auth.sqlite
MCP_SERVER_NAME=eink-dash
